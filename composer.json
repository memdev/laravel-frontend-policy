{
    "name": "memdev/laravel-frontend-policy",
    "description": "Using Laravel's authorization on the front-end.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Cone Development",
            "email": "hello@conedevelopment.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Pine\\Policy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pine\\Policy\\Tests\\": "tests/",
            "Pine\\Policy\\Tests\\Factories\\": "tests/factories/"
        }
    },
    "require": {
        "php" : "^7.2.5 | ^8.0",
        "laravel/framework": "^6.0 || ^7.0 || ^8.24 || ^9.0 || ^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "laravel/laravel": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "fzaninotto/faker": "@stable",
        "mockery/mockery": "@stable",
        "phpunit/phpunit": "@stable"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pine\\Policy\\PolicyServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    },
    "minimum-stability" : "dev",
    "prefer-stable" : true
}
